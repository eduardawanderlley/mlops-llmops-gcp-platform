            "parameterType": "STRING"
          }
        }
      },
      "outputDefinitions": {
        "artifacts": {
          "chunked_output": {
            "artifactType": {
              "schemaTitle": "system.Artifact",
              "schemaVersion": "0.0.1"
            }
          }
        }
      }
    },
    "comp-generate-embeddings-and-load": {
      "executorLabel": "exec-generate-embeddings-and-load",
      "inputDefinitions": {
        "artifacts": {
          "chunked_input": {
            "artifactType": {
              "schemaTitle": "system.Artifact",
              "schemaVersion": "0.0.1"
            }
          }
        },
        "parameters": {
          "dataset_name": {
            "parameterType": "STRING"
          },
          "project_id": {
