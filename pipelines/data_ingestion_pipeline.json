                "componentInputParameter": "source_gcs_path"
              }
            }
          },
          "taskInfo": {
            "name": "extract-and-chunk-documents"
          }
        },
        "generate-embeddings-and-load": {
          "cachingOptions": {
            "enableCache": true
          },
          "componentRef": {
            "name": "comp-generate-embeddings-and-load"
          },
          "dependentTasks": [
            "extract-and-chunk-documents"
          ],
          "inputs": {
            "artifacts": {
              "chunked_input": {
                "taskOutputArtifact": {
                  "outputArtifactKey": "chunked_output",
                  "producerTask": "extract-and-chunk-documents"
                }
              }
            },
            "parameters": {
              "dataset_name": {
                "componentInputParameter": "dataset_name"
